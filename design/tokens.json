{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Portfolio design tokens: single source of truth. Palette 'Threshold' (revised 2026-09-22, D-003). Contrast vs bg computed 2026-09-22.",
  "color": {
    "dark": {
      "bg": {
        "$value": "#10130F",
        "$description": "wet threshold floor, green-black"
      },
      "surface": {
        "$value": "#171B16"
      },
      "raised": {
        "$value": "#1F241E"
      },
      "line": {
        "$value": "#2C332B",
        "$description": "grid dots idle, borders"
      },
      "text": {
        "$value": "#ECE9DF",
        "contrast": 15.41,
        "$description": "rice-flour white"
      },
      "muted": {
        "$value": "#A4A697",
        "contrast": 7.56
      },
      "faint": {
        "$value": "#72766B",
        "contrast": 4.03,
        "$description": "large text / decorative only"
      },
      "accent": {
        "$value": "#F2A93B",
        "contrast": 9.37,
        "$description": "marigold"
      },
      "accent-2": {
        "$value": "#4CC3AE",
        "contrast": 8.67,
        "$description": "teal: system/data/flows only"
      },
      "signal": {
        "$value": "#EC6A52",
        "contrast": 6.02,
        "$description": "kumkum: errors, incidents"
      },
      "on-accent": {
        "$value": "#10130F",
        "contrast": 9.37
      }
    },
    "light": {
      "bg": {
        "$value": "#ECEEE7",
        "$description": "limestone, green-grey (deliberately not cream)"
      },
      "surface": {
        "$value": "#F6F7F2"
      },
      "raised": {
        "$value": "#FFFFFF"
      },
      "line": {
        "$value": "#D3D7CB"
      },
      "text": {
        "$value": "#141712",
        "contrast": 15.46
      },
      "muted": {
        "$value": "#51564B",
        "contrast": 6.45
      },
      "faint": {
        "$value": "#80857A",
        "contrast": 3.23,
        "$description": "large text / decorative only"
      },
      "accent": {
        "$value": "#8F5304",
        "contrast": 5.27,
        "$description": "deep marigold"
      },
      "accent-2": {
        "$value": "#08665A",
        "contrast": 5.87
      },
      "signal": {
        "$value": "#AE2F1C",
        "contrast": 5.57
      },
      "on-accent": {
        "$value": "#F6F7F2",
        "contrast": 5.73
      }
    }
  },
  "font": {
    "display": {
      "$value": "'Anek Latin', 'Arial Narrow', ui-sans-serif, sans-serif",
      "$description": "variable wdth 75-125, wght 100-800; Ek Type (Indian foundry); Anek Tamil for Tamil"
    },
    "text": {
      "$value": "'Geist', ui-sans-serif, system-ui, sans-serif"
    },
    "mono": {
      "$value": "'Geist Mono', ui-monospace, 'SFMono-Regular', monospace"
    },
    "tamil": {
      "$value": "'Anek Tamil', 'Noto Sans Tamil', sans-serif"
    }
  },
  "type": {
    "display-xl": {
      "size": "clamp(3.5rem, 2.15rem + 6vw, 8rem)",
      "lineHeight": 0.95,
      "tracking": "-0.03em"
    },
    "display": {
      "size": "clamp(2.5rem, 1.67rem + 3.7vw, 5rem)",
      "lineHeight": 1.0,
      "tracking": "-0.025em"
    },
    "h1": {
      "size": "clamp(2rem, 1.5rem + 2.22vw, 3.5rem)",
      "lineHeight": 1.05,
      "tracking": "-0.02em"
    },
    "h2": {
      "size": "clamp(1.625rem, 1.33rem + 1.3vw, 2.5rem)",
      "lineHeight": 1.1,
      "tracking": "-0.015em"
    },
    "h3": {
      "size": "clamp(1.25rem, 1.13rem + 0.56vw, 1.625rem)",
      "lineHeight": 1.25,
      "tracking": "-0.01em"
    },
    "body-lg": {
      "size": "clamp(1.125rem, 1.08rem + 0.19vw, 1.25rem)",
      "lineHeight": 1.6,
      "tracking": "0"
    },
    "body": {
      "size": "clamp(1rem, 0.98rem + 0.09vw, 1.0625rem)",
      "lineHeight": 1.65,
      "tracking": "0"
    },
    "small": {
      "size": "0.875rem",
      "lineHeight": 1.5,
      "tracking": "0.005em"
    },
    "mono-sm": {
      "size": "0.8125rem",
      "lineHeight": 1.5,
      "tracking": "0"
    },
    "eyebrow": {
      "size": "0.75rem",
      "lineHeight": 1.2,
      "tracking": "0.12em",
      "transform": "uppercase",
      "family": "mono"
    }
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px",
    "16": "64px",
    "24": "96px",
    "32": "128px",
    "48": "192px"
  },
  "grid": {
    "pulliPitch": {
      "mobile": "24px",
      "desktop": "32px"
    },
    "container": "1240px",
    "gutter": {
      "mobile": "16px",
      "desktop": "40px"
    },
    "columns": {
      "mobile": 4,
      "desktop": 12
    }
  },
  "radius": {
    "sm": "6px",
    "md": "12px",
    "lg": "20px",
    "pill": "999px"
  },
  "motion": {
    "spring": {
      "snappy": {
        "stiffness": 500,
        "damping": 35
      },
      "smooth": {
        "stiffness": 260,
        "damping": 30
      },
      "gentle": {
        "stiffness": 120,
        "damping": 20
      }
    },
    "ease": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)"
    },
    "duration": {
      "instant": "100ms",
      "fast": "180ms",
      "base": "320ms",
      "slow": "600ms",
      "draw": "1200ms"
    }
  }
}