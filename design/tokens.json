{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Portfolio design tokens: single source of truth. Status: draft (D-003 proposed). Contrast ratios computed 2026-09-22; see docs/04-design-system.md.",
  "color": {
    "dark": {
      "bg":        { "$value": "#0B0D10" },
      "surface":   { "$value": "#14171C" },
      "raised":    { "$value": "#1C2027" },
      "line":      { "$value": "#2A2F38" },
      "text":      { "$value": "#EDE8DE", "contrast": 15.93 },
      "muted":     { "$value": "#A09B91", "contrast": 7.03 },
      "faint":     { "$value": "#6E6A63", "contrast": 3.62, "$description": "large text / decorative only" },
      "accent":    { "$value": "#F2A93B", "contrast": 9.74, "$description": "marigold" },
      "accent-2":  { "$value": "#45C1B6", "contrast": 8.85, "$description": "teal: system/data/flows only" },
      "signal":    { "$value": "#E8604A", "contrast": 5.75, "$description": "kumkum: errors, incidents" },
      "on-accent": { "$value": "#0B0D10", "contrast": 9.74 }
    },
    "light": {
      "bg":        { "$value": "#F4F0E8" },
      "surface":   { "$value": "#FBF8F2" },
      "raised":    { "$value": "#FFFFFF" },
      "line":      { "$value": "#DDD6C8" },
      "text":      { "$value": "#15171B", "contrast": 15.79 },
      "muted":     { "$value": "#5A564E", "contrast": 6.42 },
      "faint":     { "$value": "#8A857B", "contrast": 3.23, "$description": "large text / decorative only" },
      "accent":    { "$value": "#9A5B06", "contrast": 4.77 },
      "accent-2":  { "$value": "#0B6F68", "contrast": 5.30 },
      "signal":    { "$value": "#B3321F", "contrast": 5.45 },
      "on-accent": { "$value": "#FBF8F2", "contrast": 5.12 }
    }
  },
  "font": {
    "display": { "$value": "'Fraunces', ui-serif, Georgia, serif" },
    "text":    { "$value": "'Geist', ui-sans-serif, system-ui, sans-serif" },
    "mono":    { "$value": "'Geist Mono', ui-monospace, 'SFMono-Regular', monospace" }
  },
  "type": {
    "display-xl": { "size": "clamp(3.5rem, 2.15rem + 6vw, 8rem)",     "lineHeight": 0.95, "tracking": "-0.03em" },
    "display":    { "size": "clamp(2.5rem, 1.67rem + 3.7vw, 5rem)",   "lineHeight": 1.0,  "tracking": "-0.025em" },
    "h1":         { "size": "clamp(2rem, 1.5rem + 2.22vw, 3.5rem)",   "lineHeight": 1.05, "tracking": "-0.02em" },
    "h2":         { "size": "clamp(1.625rem, 1.33rem + 1.3vw, 2.5rem)", "lineHeight": 1.1, "tracking": "-0.015em" },
    "h3":         { "size": "clamp(1.25rem, 1.13rem + 0.56vw, 1.625rem)", "lineHeight": 1.25, "tracking": "-0.01em" },
    "body-lg":    { "size": "clamp(1.125rem, 1.08rem + 0.19vw, 1.25rem)", "lineHeight": 1.6, "tracking": "0" },
    "body":       { "size": "clamp(1rem, 0.98rem + 0.09vw, 1.0625rem)", "lineHeight": 1.65, "tracking": "0" },
    "small":      { "size": "0.875rem",  "lineHeight": 1.5, "tracking": "0.005em" },
    "mono-sm":    { "size": "0.8125rem", "lineHeight": 1.5, "tracking": "0" },
    "eyebrow":    { "size": "0.75rem",   "lineHeight": 1.2, "tracking": "0.12em", "transform": "uppercase", "family": "mono" }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "6": "24px", "8": "32px", "12": "48px", "16": "64px", "24": "96px", "32": "128px", "48": "192px" },
  "grid": {
    "pulliPitch": { "mobile": "24px", "desktop": "32px" },
    "container": "1240px",
    "gutter": { "mobile": "16px", "desktop": "40px" },
    "columns": { "mobile": 4, "desktop": 12 }
  },
  "radius": { "sm": "6px", "md": "12px", "lg": "20px", "pill": "999px" },
  "motion": {
    "spring": {
      "snappy": { "stiffness": 500, "damping": 35 },
      "smooth": { "stiffness": 260, "damping": 30 },
      "gentle": { "stiffness": 120, "damping": 20 }
    },
    "ease": { "out": "cubic-bezier(0.16, 1, 0.3, 1)", "inOut": "cubic-bezier(0.65, 0, 0.35, 1)" },
    "duration": { "instant": "100ms", "fast": "180ms", "base": "320ms", "slow": "600ms", "draw": "1200ms" }
  }
}
